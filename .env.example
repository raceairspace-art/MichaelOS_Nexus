# Required for text collaboration, manual Nexus review, and Realtime voice. Keep server-side only.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin

# Digital Oliver durable research store. Secret/service-role key MUST stay server-side.
SUPABASE_URL=https://mutgmifeyabrbjjmjfoq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth. The publishable key is intentionally safe for client/server identification;
# Nexus still verifies every session server-side and restricts access to the allowed user ID.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_2Q0OFkqsDdxSwrx3NIneYg_QX4V3152
NEXUS_ALLOWED_USER_ID=e1be1dc8-0745-482f-9c2f-d425f69ddf34

# Vercel sets this server-side when Protection Bypass for Automation is configured.
# GitHub Actions stores its own encrypted copy under the same name.
VERCEL_AUTOMATION_BYPASS_SECRET=
